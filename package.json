{
  "name": "ai-video-factory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "start chrome.exe --remote-debugging-port=9222 --remote-allow-origins=* --user-data-dir=\"C:\\\\chrome_debug_profile\" && cross-env NODE_OPTIONS=--dns-result-order=ipv4first tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx"
  },
