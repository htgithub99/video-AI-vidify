{
    "name": "ai-video-factory",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --ignore \"database.db*\" --ignore \"projects.json\" --ignore \"vite.config.ts.timestamp-*\" server.ts",
        "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && javascript-obfuscator dist/server.cjs --output dist/server.cjs --compact true --self-defending false --simplify true --string-array true --string-array-encoding base64 --string-array-threshold 0.8 && bytenode --compile dist/server.cjs && node -e \"require('fs').unlinkSync('dist/server.cjs')\"",
        "start": "node dist/server.cjs",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx",
        "test:baseline": "tsx scripts/verify-baseline.ts && tsx scripts/verify-advanced.ts && tsx scripts/verify-shadow.ts && tsx scripts/verify-prompt-config.ts && tsx scripts/verify-image-prompt-qa.ts && tsx scripts/verify-image-assets.ts && tsx scripts/verify-scene-references.ts && tsx scripts/verify-thumbnail-generation.ts && tsx scripts/verify-response-contract.ts && tsx scripts/verify-upscale.ts && tsx scripts/verify-utf8.ts && tsx scripts/verify-clean-code.ts && tsx scripts/verify-pipeline-resilience.ts && tsx scripts/verify-storyboard-chapters.ts && tsx scripts/verify-gemini-routing.ts && tsx scripts/verify-free-ai-providers.ts",
        "test:video2": "tsx scripts/verify-video2-flow.ts && tsx scripts/verify-render-integration.ts",
        "electron:dev": "cross-env NODE_ENV=development electron .",
        "electron:build": "powershell -ExecutionPolicy Bypass -File ./clean-build.ps1"
    },
    "dependencies": {
        "@google/genai": "latest",
        "@tanstack/react-query": "^5.101.4",
        "bytenode": "^1.5.5",
        "cors": "^2.8.5",
        "express": "^4.19.2",
        "fluent-ffmpeg": "^2.1.3",
        "jszip": "^3.10.1",
        "lodash": "^4.18.1",
        "node-machine-id": "^1.1.12",
        "playwright": "^1.45.0",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sonner": "^2.0.7",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0-alpha.18",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/lodash": "^4.17.24",
        "@types/node": "^20.14.10",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "@vitejs/plugin-react": "^4.3.1",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "electron": "^43.1.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.23.0",
        "eslint": "^8.57.0",
        "framer-motion": "^12.42.2",
        "javascript-obfuscator": "^5.5.0",
        "lucide-react": "^0.407.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.4.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3",
        "uuid": "^10.0.0",
        "vite": "^5.3.4"
    },
    "build": {
        "appId": "com.aivideofactory.app",
        "productName": "Video Workspace",
        "directories": {
            "output": "builds/build-temp"
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Video Workspace",
            "differentialPackage": false
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json",
            "!builds/**/*",
            "!dist-desktop/**/*"
        ],
        "extraResources": [
            "python_scripts",
            "ffmpeg.exe",
            "database.db"
        ],
        "asar": true,
        "asarUnpack": [
            "**/*.{node,dll,exe,py}"
        ]
    }
}
