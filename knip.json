{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "server.ts",
    "vite.config.ts",
    "electron/**/*.cjs",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server.ts",
    "vite.config.ts",
    "electron/**/*.cjs",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": ["electron-builder", "tailwindcss"]
}
