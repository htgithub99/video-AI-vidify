 "subtitles": [
  {
   "start": 6.5,
   "end": 10,
   "text": "Mùa xuân năm 1976, thành phố Nice, nước Pháp."
  },
  {
   "start": 10,
   "end": 13,
   "text": "Một nhiếp ảnh gia bình thường bước đi trên phố."
  },
  {
   "start": 13.4,
   "end": 18.5,
   "text": "Ông bước vào ngân hàng an toàn nhất nước Pháp với một chiếc đồng hồ trong túi."
  },
  {
   "start": 19.3,
   "end": 24.6,
   "text": "Nửa đêm, chiếc đồng hồ reo lên trong hầm két… nhưng không ai nghe thấy."
  },
  {
   "start": 25.3,
   "end": 30.6,
   "text": "Hầm két không hề có báo động âm thanh."
  },
  {
   "start": 31.3,
   "end": 37.6,
   "text": "Từ cống ngầm của thành phố, chỉ cách sàn hầm tám mét."
  },
  {
   "start": 38.3,
   "end": 44.6,
   "text": "Suốt sáu mươi đêm, cả nhóm đào, khoan và hàn trong bóng tối."
  },
  {
   "start": 51.3,
   "end": 57.6,
   "text": "Họ ăn uống ngay giữa hầm, rồi để lại một dòng chữ trên tường."
  },
  {
   "start": 58.3,
   "end": 63.6,
   "text": "Bị bắt, ông nhảy qua cửa sổ tòa án và trốn trên một chiếc mô tô."
  }
 ]
