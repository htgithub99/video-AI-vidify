{
    "name": "ai-video-factory",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "start chrome.exe --remote-debugging-port=9222 --remote-allow-origins=* --user-data-dir=\"C:\\\\chrome_debug_profile\" && cross-env NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --ignore \"database.db*\" --ignore \"projects.json\" server.ts",
        "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "start": "node dist/server.cjs",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx",
        "electron:dev": "cross-env NODE_ENV=development electron .",
        "electron:build": "powershell -ExecutionPolicy Bypass -File ./clean-build.ps1"
    },
    "dependencies": {
        "@google/genai": "latest",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.19.2",
        "fluent-ffmpeg": "^2.1.3",
        "jszip": "^3.10.1",
        "lodash": "^4.18.1",
        "playwright": "^1.45.0",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@radix-ui/react-accordion": "^1.2.0",
        "@radix-ui/react-dialog": "^1.1.1",
        "@radix-ui/react-dropdown-menu": "^2.1.1",
        "@radix-ui/react-icons": "^1.3.0",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-popover": "^1.1.1",
        "@radix-ui/react-progress": "^1.1.0",
        "@radix-ui/react-select": "^2.1.1",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slider": "^1.2.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.0",
        "@radix-ui/react-tabs": "^1.1.0",
        "@radix-ui/react-tooltip": "^1.1.1",
        "@tailwindcss/vite": "^4.0.0-alpha.18",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/lodash": "^4.17.24",
        "@types/node": "^20.14.10",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "electron": "^43.1.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.23.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.7",
        "framer-motion": "^12.42.2",
        "lucide-react": "^0.407.0",
        "postcss": "^8.4.39",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.4.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3",
        "uuid": "^10.0.0",
        "vite": "^5.3.4"
    },
    "build": {
        "appId": "com.aivideofactory.app",
        "productName": "Video Workspace",
        "directories": {
            "output": "builds/build-temp"
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Video Workspace",
            "differentialPackage": false
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json",
            "!builds/**/*",
            "!dist-desktop/**/*"
        ],
        "extraResources": [
            "python_scripts",
            "ffmpeg.exe",
            "database.db"
        ],
        "asar": true,
        "asarUnpack": [
            "**/*.{node,dll,exe,py}"
        ]
    }
}
